# Gmail address that will SEND the mail
EMAIL_USER=your.email@gmail.com

# 16-character Gmail App Password (NOT your normal Gmail password)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your16charapppassword

# Address that RECEIVES the contact form messages (can be same as EMAIL_USER)
RECEIVER_EMAIL=gsoni7424@gmail.com

# Your deployed frontend URL (Render Static Site), used for CORS.
# For local dev this defaults to http://localhost:5173 if unset.
# You can comma-separate multiple: https://your-site.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Render sets this automatically in production; safe to leave unset locally
PORT=5000
