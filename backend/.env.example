# Resend API key (free at https://resend.com/api-keys)
# Used to send mail over HTTPS instead of blocked SMTP ports on Render free tier
RESEND_API_KEY=re_your_api_key_here

# Address that RECEIVES the contact form messages.
# Must be the SAME email you signed up to Resend with, unless you verify
# your own sending domain on Resend.
RECEIVER_EMAIL=gsoni7424@gmail.com

# Your deployed frontend URL (Render Static Site), used for CORS.
# For local dev this defaults to http://localhost:5173 if unset.
# You can comma-separate multiple: https://your-site.onrender.com,http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Render sets this automatically in production; safe to leave unset locally
PORT=5000
